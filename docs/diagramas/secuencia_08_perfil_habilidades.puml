@startuml secuencia_08_perfil_habilidades
!include estilo_moderno.puml
skinparam linetype polyline
autonumber

title Secuencia HU-008 — Ver Perfil del Jugador y Editar Descripción de Habilidades

actor "Jugador" as J
participant "Frontend\n(Juego.jsx / ModalPerfil)" as FE
participant "Backend Express\n(/api/perfil)" as BE
database "Supabase\n(usuario / usuario_general)" as DB

J -> FE : Hace clic en su nombre/medalla arriba a la izquierda
FE -> BE : GET /api/perfil/:usuarioId
BE -> DB : SELECT nombres, puntos, descripcion FROM usuario_general
DB --> BE : Datos actuales del perfil
BE -> BE : Calcula rango según puntos (Novato, Aprendiz, Oficial, Maestro)
BE --> FE : 200 OK (Perfil con puntos, rango y descripción)
FE --> J : Abre ventana ModalPerfil

group Editar y guardar habilidades
  J -> FE : Escribe sus habilidades de agricultura y presiona Guardar
  FE -> BE : PUT /api/perfil/:usuarioId/descripcion { descripcion }
  BE -> DB : UPDATE usuario_general SET descripcion = $1
  DB --> BE : Descripción actualizada
  BE --> FE : 200 OK (Perfil actualizado)
  FE --> J : Muestra la nueva descripción guardada en su perfil
end
@enduml
