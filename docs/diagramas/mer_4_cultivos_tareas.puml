@startuml mer_4_cultivos_tareas
!include estilo_moderno.puml
skinparam linetype ortho
hide methods
hide circle

title MER Dominio 4 — Cultivos, Parcelas y Tareas del Huerto (Esquema: huertos)

package "Dominio 4: Cultivos, Parcelas y Tareas" {
  entity "zonas_huerto" as zona {
    * **id_zona** : bigint <<PK>>
    --
    * id_huerto : bigint <<FK>>
    * nombre : text
    zona_mapa : integer
    parcela_mapa : integer
  }

  entity "ciclos_zona" as ciclo {
    * **id_ciclo** : bigint <<PK>>
    --
    * id_zona : bigint <<FK>>
    * id_huerto : bigint <<FK>>
    * created_at : timestamptz
  }

  entity "huerto_planta" as huerto_planta {
    * **id_huerto** : bigint <<PK, FK>>
    * **id_planta** : bigint <<PK, FK>>
    * **fecha_siembra** : timestamptz <<PK>>
    --
    * cantidad : integer
    * id_estado : smallint <<FK>>
    zona : smallint
    parcela : smallint
    * observaciones : text
  }

  entity "cultivos_checklist" as cult_check {
    * **id_huerto** : bigint <<PK, FK>>
    * **id_planta** : bigint <<PK, FK>>
    * **fecha_siembra** : timestamptz <<PK, FK>>
    --
    id_ciclo : bigint <<FK>>
    parte_cosecha : text
    * conservado_tras_cosecha : boolean
  }

  entity "estado_cultivo" as estado {
    * **id_estado** : smallint <<PK>>
    --
    * nombre : text
  }

  entity "actividades" as actividades {
    * **codigo** : text <<PK>>
    --
    * nombre : text
    * puntos : integer
  }

  entity "tareas_huerto" as tarea {
    * **id_tarea** : bigint <<PK>>
    --
    * codigo_actividad : text <<FK>>
    * id_huerto : bigint <<FK>>
    id_zona : bigint <<FK>>
    id_ciclo : bigint <<FK>>
    id_planta : bigint <<FK>>
    fecha_siembra : timestamptz <<FK>>
    programada_para : timestamptz
    completada_en : timestamptz
    completada_por : bigint <<FK>>
    * confirmaciones : jsonb
  }

  entity "participantes_tarea" as part_tarea {
    * **id_tarea** : bigint <<PK, FK>>
    * **id_usuario** : bigint <<PK, FK>>
    --
    puntos_otorgados : integer
  }
}

package "Conexiones a otros dominios" {
  entity "huerto" as ext_huerto <<Conexion>> {
    * **id_huerto** : bigint <<PK>>
  }

  entity "planta" as ext_planta <<Conexion>> {
    * **id_planta** : bigint <<PK>>
  }

  entity "usuario_general" as ext_ugen <<Conexion>> {
    * **id_usuario** : bigint <<PK>>
  }
}

note top of ext_huerto
  Conexión hacia Dominio 2 (Huerto)
end note

note top of ext_planta
  Conexión hacia Dominio 3 (Planta)
end note

note top of ext_ugen
  Conexión hacia Dominio 1 (Jugador)
end note

zona ||--o{ ciclo
estado ||--o{ huerto_planta
huerto_planta ||--o| cult_check
ciclo ||--o{ cult_check
actividades ||--o{ tarea
zona ||--o{ tarea
ciclo ||--o{ tarea
huerto_planta ||--o{ tarea
tarea ||--o{ part_tarea

ext_huerto ||..o{ zona : "conexión (id_huerto)"
ext_huerto ||..o{ huerto_planta : "conexión (id_huerto)"
ext_huerto ||..o{ tarea : "conexión (id_huerto)"
ext_planta ||..o{ huerto_planta : "conexión (id_planta)"
ext_ugen ||..o{ tarea : "conexión (completada_por)"
ext_ugen ||..o{ part_tarea : "conexión (id_usuario)"
@enduml
