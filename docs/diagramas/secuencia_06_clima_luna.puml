@startuml secuencia_06_clima_luna
!include estilo_moderno.puml
skinparam linetype polyline
autonumber

title Secuencia HU-006 — Consulta del Clima Actual y Fase Lunar en el Huerto

actor "Jugador" as J
participant "Frontend\n(Juego.jsx)" as FE
participant "Hooks Agroclimáticos\n(useClima / useFaseLunar)" as HK
participant "API Externa\n(Open-Meteo)" as API

J -> FE : Entra al huerto de su gremio (/juego)
FE -> HK : Pasa ubicación del huerto (latitud, longitud)
HK -> HK : Calcula fase lunar astronómica según fecha actual\n(Nueva, Creciente, Llena o Menguante)
HK -> API : GET /v1/forecast?latitude=...&longitude=...&current_weather=true

alt Respuesta exitosa del servicio de clima
  API --> HK : 200 OK (Temperatura en °C y código de clima)
  HK --> FE : Estado del clima actual + Fase lunar
  FE --> J : Muestra íconos de temperatura, clima y luna con consejos
else Sin internet o caída del servicio externo
  API --> HK : Error de red / Timeout
  HK --> FE : Clima de respaldo por defecto + Fase lunar calculada
  FE --> J : Muestra la pantalla del huerto funcionando sin bloquearse
end
@enduml
