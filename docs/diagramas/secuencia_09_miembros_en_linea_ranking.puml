@startuml secuencia_09_miembros_en_linea_ranking
!include estilo_moderno.puml
skinparam linetype polyline
autonumber

title Secuencia HU-009 — Ver Miembros en Línea y Consultar Ranking de Gremios

actor "Jugador" as J
participant "Frontend\n(Gremio.jsx / RankingGremios)" as FE
participant "Backend Express\n(/api/gremios)" as BE
database "Supabase\n(miembro_gremio / usuario_general / gremio)" as DB

group 1. Ver miembros en línea del gremio (Pestaña Miembros)
  J -> FE : Abre pantalla /gremio y selecciona pestaña 'Miembros'
  FE -> BE : GET /api/gremios/:id
  BE -> DB : SELECT miembros del gremio, puntos, rol y last_seen
  DB --> BE : Lista de miembros con su última actividad
  BE -> BE : Calcula enLinea = true si last_seen está dentro del tiempo activo
  BE --> FE : 200 OK (Gremio y miembros con estado enLinea)
  FE --> J : Muestra '(En línea: X / Total)' y tabla ordenada por puntos\ncon punto verde ('en línea' / 'desconectado')
end

group 2. Consultar tabla de posiciones (Pestaña Ranking de gremios)
  J -> FE : Selecciona pestaña 'Ranking de gremios'
  FE -> BE : GET /api/gremios
  BE -> DB : SELECT gremios ordenados por puntos_gremio DESC
  DB --> BE : Lista de gremios con puntos y cantidad de miembros
  BE --> FE : 200 OK (Ranking de gremios)
  FE --> J : Muestra tabla con Posición, Gremio, Puntos y Miembros actuales
end
@enduml
