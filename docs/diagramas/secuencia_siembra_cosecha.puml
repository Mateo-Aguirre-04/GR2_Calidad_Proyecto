@startuml secuencia_siembra_cosecha
!include estilo_moderno.puml
skinparam linetype polyline
autonumber

title Diagrama de Secuencia — Siembra en Parcela, Cuidado y Cosecha

actor "Jugador" as J
participant "Frontend\n(Juego.jsx / useChecklist)" as FE
participant "Backend Express\n(/api/huertos)" as BE
database "Supabase\n(PostgreSQL)" as DB

group 1. Sembrar planta en una parcela preparada
  J -> FE : Elige parcela, planta y cantidad a sembrar
  FE -> BE : POST /api/huertos/:id/checklist/sembrar
  BE -> DB : Registra cultivo en huerto_planta\nCompleta tarea de siembra en tareas_huerto\nSuma puntos en usuario_general y gremio
  DB --> BE : Cultivo guardado y puntos otorgados
  BE --> FE : 200 OK (Cultivo activo y puntos ganados)
  FE --> J : Dibuja la planta en la parcela y muestra puntos
end

group 2. Regar o Cosechar y subir de rango
  J -> FE : Usa herramienta de Riego o Cosecha sobre la parcela
  FE -> BE : POST /api/huertos/:id/checklist/tareas/:tareaId/completar
  BE -> DB : Marca tarea completada en tareas_huerto\nActualiza estado en huerto_planta\nSuma puntos al jugador y al gremio
  DB --> BE : Nuevo total de puntos y rango actualizado
  BE --> FE : 200 OK (Comprobante y puntos sumados)
  FE --> J : Actualiza medalla de rango, puntos y vista del huerto
end

@enduml
