@startuml secuencia_04_catalogo_plantas
!include estilo_moderno.puml
skinparam linetype polyline
autonumber

title Secuencia HU-004 — Consulta y Filtrado del Catálogo de Plantas Ecuatorianas

actor "Jugador" as J
participant "Frontend\n(Catalogo.jsx / ModalPlanta)" as FE
participant "Backend Express\n(GET /api/plantas)" as BE
database "Supabase\n(planta / familia / usos)" as DB

J -> FE : Abre la pantalla Catálogo (/catalogo-plantas)
FE -> BE : GET /api/plantas
BE -> DB : SELECT plantas con familia_botanica,\ntipo_planta, usos medicinales y provincias
DB --> BE : Lista de plantas ecuatorianas
BE --> FE : 200 OK (Catálogo completo con imágenes y cuidados)
FE --> J : Muestra tarjetas de plantas

group Filtrado y consulta de ficha de una planta
  J -> FE : Filtra por región ('Sierra' / 'Costa') o escribe nombre
  FE -> FE : Filtra en pantalla las plantas coincidentes
  J -> FE : Hace clic en una planta (ej. Papa Chaucha)
  FE --> J : Abre ModalPlanta con nombre científico, altitud,\nclima, riego, abono y usos medicinales
end
@enduml
