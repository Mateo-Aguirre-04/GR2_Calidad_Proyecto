@startuml mer_3_catalogo_plantas
!include estilo_moderno.puml
skinparam linetype ortho
hide methods
hide circle

title MER Dominio 3 — Catálogo de Plantas Ecuatorianas (Esquema: huertos)

package "Dominio 3: Catálogo de Plantas Ecuatorianas" {
  entity "planta" as planta {
    * **id_planta** : bigint <<PK>>
    --
    * id_familia : bigint <<FK>>
    * id_tipo_planta : bigint <<FK>>
    * nombre_comun : text
    * nombre_cientifico : text
    nombre_alternativo : text
    * altitud_minima : numeric
    * altitud_maxima : numeric
    * ciclo_cultivo : text
    region : varchar
    descripcion : text
    cuidados : jsonb
    fases : jsonb
    imagen : text
  }

  entity "familia_botanica" as familia {
    * **id_familia** : bigint <<PK>>
    --
    * nombre : text
    * descripcion : text
  }

  entity "tipo_planta" as tipo_planta {
    * **id_tipo_planta** : bigint <<PK>>
    --
    * nombre : text
    * descripcion : text
  }

  entity "uso_medicinal" as uso {
    * **id_uso** : bigint <<PK>>
    --
    * descripcion : text
  }

  entity "planta_uso_medicinal" as planta_uso {
    * **id_planta** : bigint <<PK, FK>>
    * **id_uso** : bigint <<PK, FK>>
  }

  entity "provincia" as provincia {
    * **id_provincia** : bigint <<PK>>
    --
    * nombre : text
  }

  entity "planta_provincia" as planta_prov {
    * **id_planta** : bigint <<PK, FK>>
    * **id_provincia** : bigint <<PK, FK>>
  }
}

package "Conexiones a otros dominios" {
  entity "huerto_planta" as ext_hp <<Conexion>> {
    * **id_huerto** : bigint <<PK, FK>>
    * **id_planta** : bigint <<PK, FK>>
    * **fecha_siembra** : timestamptz <<PK>>
  }
}

note right of ext_hp
  Conexión hacia Dominio 4
  (Cultivos sembrados en el huerto)
end note

familia ||--o{ planta
tipo_planta ||--o{ planta
planta ||--o{ planta_uso
uso ||--o{ planta_uso
planta ||--o{ planta_prov
provincia ||--o{ planta_prov

planta ||..o{ ext_hp : "conexión (id_planta)"
@enduml
